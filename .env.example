# Bronze ingestion mode: file | api | hybrid
BRONZE_INGESTION_MODE=file

# Optional OpenFEC credentials/filters
OPENFEC_API_KEY=
OPENFEC_CYCLE=2026
OPENFEC_STATE=
OPENFEC_PAGES=1
OPENFEC_PER_PAGE=100

# Optional single remote CSV URL for state finance export
STATE_CSV_URL=

# Airflow container UID for mounted volumes
AIRFLOW_UID=50000
